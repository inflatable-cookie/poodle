{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@poodle/svelte-preview/*": ["./packages/svelte/preview/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts"
  ]
}
