{
  "schema": "poodle.g16-nucleus-a11y-scenario.v1",
  "component": "ToastHost",
  "scenario_id": "nucleus.attention.toast-host",
  "props": {
    "placement": "top-start",
    "ariaLabel": "Job notices",
    "autoDismissMs": 0,
    "toasts": [
      {
        "id": "saved",
        "title": "Saved",
        "message": "Your changes were saved.",
        "tone": "success"
      },
      {
        "id": "failed",
        "title": "Publishing failed",
        "message": "We could not publish your changes.",
        "tone": "danger",
        "actionLabel": "Retry"
      }
    ]
  },
  "actions": [],
  "declared_states": [],
  "capture": {
    "width": 720,
    "height": 520
  },
  "web_only_exclusions": [],
  "roleRemaps": [
    {
      "index": 3,
      "field": "role",
      "gpui": "alert",
      "svelte": "listitem",
      "reason": "Contract toast-stack.md native mapping: danger rows project NodeRole::Alert while Svelte renders li with an assertive live region. Sanctioned cross-runtime role projection, not an assistive-technology parity claim."
    }
  ]
}
