# Local preview tarballs and clean-install evidence.
.artifacts/

# Native visual gate baselines (g12.014).
#
# Deliberately NOT committed. They are transient reference images regenerated
# on demand, and the GPUI set alone is 103MB of full-window screenshots — git
# storage that grows with every rebaseline and is never reclaimed. Both gates
# write a missing baseline on first run and say so, so a fresh clone
# self-populates.
packages/gpui/preview/baselines/
packages/jetstream/preview/baselines/
test/native-visual/out/
test/native-visual/out-jetstream/

# Generated Lucide icon modules in poodle-core — run
# `node packages/core/src/icons/generate.mjs` to rebuild.
packages/core/src/icons/icons/
packages/core/src/icons/index.ts
packages/core/src/icons/types.ts
