*~
.DS_Store

# Logs
# Runtime logs only. Anchored: an unanchored `logs/` also matches `docs/logs/`,
# which is documentation and belongs in the repo — that collision is what the
# per-month re-include rules here were working around.
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.svelte-check/
.parcel-cache/
.eslintcache
.stylelintcache

# Misc
*.pid
*.seed
*.pid.lock

# Rust/GPUI specific
**/target/
Cargo.lock
# The GPUI preview is an application and its CI graph must stay reproducible.
!packages/gpui/preview/Cargo.lock
**/*.rs.bk
*.pdb

# SvelteKit
.svelte-kit/
.declaration-staging/
.vercel/
.netlify/

# Temporary files
*.tmp
*.temp

# Effigy

# Screenshots (Jetstream preview debug captures)
docs/screenshots/
.claude/settings.local.json

# BEGIN EFFIGY LOCAL STATE
.effigy/
# END EFFIGY LOCAL STATE

# Local preview tarballs and clean-install evidence.
.artifacts/

# Native visual gate baselines (g12.014).
#
# Deliberately NOT committed. They are transient reference images regenerated
# on demand, and the GPUI set alone is 103MB of full-window screenshots — git
# storage that grows with every rebaseline and is never reclaimed. Both gates
# write a missing baseline on first run and say so, so a fresh clone
# self-populates.
packages/gpui/preview/baselines/
packages/jetstream/preview/baselines/
test/native-visual/out/
test/native-visual/out-jetstream/
# g15.047 Button comparison: same-run evidence goes to docs/logs via --out;
# the default directory is disposable.
test/visual/button-comparison/out/
test/visual/inset-shadow-evidence/out/
# Per-runtime conformance observation reports (spec 066) — written by the
# web vitest run and the native cargo runners, consumed by conformance:compare.
test/conformance/web/out/
release-artifacts/
