    "@poodle/icons-lucide": "workspace:*"
  },
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "experimental"
  },
  "devDependencies": {
    "@types/react": "^19.1.0"
  }
}
