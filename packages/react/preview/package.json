    "accessibility:report": "bun scripts/build-accessibility-report.ts",
    "reports": "bun scripts/export-component-docs.ts && bun scripts/build-parity-report.ts && bun scripts/build-accessibility-report.ts"
  },
  "dependencies": {
    "@inflatable-cookie/poodle-react": "workspace:*",
    "@inflatable-cookie/poodle-core": "workspace:*",
    "lucide-static": "1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
