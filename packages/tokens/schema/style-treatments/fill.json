{
  "outlined": {
    "style": {
      "control": {
        "fill": {
          "$type": "color",
          "$value": "initial"
        },
        "border": {
          "$type": "color",
          "$value": "initial"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "initial"
        }
      }
    }
  },
  "filled": {
    "style": {
      "control": {
        "fill": {
          "$type": "color",
          "$value": "{color.control.neutral.fill}"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "none"
        },
        "fillHover": {
          "$type": "color",
          "$value": "{color.control.neutral.hover}"
        },
        "fillActive": {
          "$type": "color",
          "$value": "{color.control.neutral.active}"
        }
      }
    }
  },
  "ghost": {
    "style": {
      "control": {
        "fill": {
          "$type": "color",
          "$value": "transparent"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "none"
        }
      }
    }
  }
}
