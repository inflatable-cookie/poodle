{
  "outlined": {
    "style": {
      "control": {
        "fill": {
          "$type": "color",
          "$value": "initial"
        },
        "border": {
          "$type": "color",
          "$value": "initial"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "initial"
        }
      }
    }
  },
  "filled": {
    "style": {
      "control": {
        "fill": {
          "$type": "color",
          "$value": "{color.fill.rest}"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "none"
        },
        "fillHover": {
          "$type": "color",
          "$value": "{color.fill.hover}"
        },
        "fillActive": {
          "$type": "color",
          "$value": "{color.fill.active}"
        },
        "secondaryText": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "secondaryOpacity": {
          "$type": "number",
          "$value": 1
        }
      }
    }
  },
  "ghost": {
    "style": {
      "control": {
        "fill": {
          "$type": "color",
          "$value": "transparent"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "none"
        }
      }
    }
  }
}
