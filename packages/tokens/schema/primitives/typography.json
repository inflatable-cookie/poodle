{
  "typography": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "\"Inter\", \"SF Pro Display\", system-ui, sans-serif"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "\"IBM Plex Mono\", \"SFMono-Regular\", monospace"
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": "400"
        },
        "medium": {
          "$type": "fontWeight",
          "$value": "500"
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": "600"
        }
      },
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": "11px"
        },
        "sm": {
          "$type": "dimension",
          "$value": "13px"
        },
        "md": {
          "$type": "dimension",
          "$value": "14px"
        },
        "lg": {
          "$type": "dimension",
          "$value": "16px"
        },
        "xl": {
          "$type": "dimension",
          "$value": "20px"
        }
      },
      "lineHeight": {
        "sm": {
          "$type": "dimension",
          "$value": "16px"
        },
        "md": {
          "$type": "dimension",
          "$value": "20px"
        },
        "lg": {
          "$type": "dimension",
          "$value": "24px"
        }
      }
    }
  }
}
