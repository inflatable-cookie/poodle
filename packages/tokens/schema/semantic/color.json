{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{primitives.color.neutral.50}",
        "$description": "Primary app canvas."
      },
      "surface": {
        "$type": "color",
        "$value": "{primitives.color.neutral.100}",
        "$description": "Secondary raised surface."
      },
      "panel": {
        "$type": "color",
        "$value": "{primitives.color.neutral.25}",
        "$description": "Panel and card surface."
      },
      "elevated": {
        "$type": "color",
        "$value": "{primitives.color.neutral.0}",
        "$description": "Floating surface."
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(11, 15, 20, 0.64)",
        "$description": "Backdrop scrim."
      }
    },
    "surface": {
      "hover": {
        "$type": "color",
        "$value": "rgba(148, 163, 184, 0.12)",
        "$description": "Subtle hover and active-line fill on a surface."
      },
      "tonal": {
        "$type": "color",
        "$value": "#d4deea",
        "$description": "Borderless container surface with a visible tone step from the underlying layer."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitives.color.neutral.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitives.color.neutral.700}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitives.color.neutral.400}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{primitives.color.neutral.0}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{primitives.color.neutral.200}"
      },
      "default": {
        "$type": "color",
        "$value": "{primitives.color.neutral.400}"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitives.color.neutral.700}"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "{primitives.color.blue.500}"
      },
      "hover": {
        "$type": "color",
        "$value": "{primitives.color.blue.400}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{primitives.color.blue.400}"
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "{primitives.color.green.500}"
      },
      "warning": {
        "$type": "color",
        "$value": "{primitives.color.amber.500}"
      },
      "danger": {
        "$type": "color",
        "$value": "{primitives.color.red.500}"
      },
      "info": {
        "$type": "color",
        "$value": "{primitives.color.blue.500}"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.text.primary}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.text.secondary}"
      }
    },
    "syntax": {
      "comment": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.comment}",
        "$description": "Syntax comments and metadata. Dark base by default; light theme modes reference the light primitives."
      },
      "keyword": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.keyword}",
        "$description": "Syntax keyword family. Dark base by default; light theme modes reference the light primitives."
      },
      "string": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.string}",
        "$description": "Syntax strings, regex, and escapes. Dark base by default; light theme modes reference the light primitives."
      },
      "literal": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.literal}",
        "$description": "Syntax numeric and atomic literals. Dark base by default; light theme modes reference the light primitives."
      },
      "type": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.type}",
        "$description": "Syntax types, classes, and namespaces. Dark base by default; light theme modes reference the light primitives."
      },
      "callable": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.callable}",
        "$description": "Syntax definitions and callables. Dark base by default; light theme modes reference the light primitives."
      },
      "property": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.property}",
        "$description": "Syntax properties, attributes, and member names. Dark base by default; light theme modes reference the light primitives."
      },
      "operator": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.operator}",
        "$description": "Syntax operators. Dark base by default; light theme modes reference the light primitives."
      },
      "punctuation": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.punctuation}",
        "$description": "Syntax punctuation and brackets. Dark base by default; light theme modes reference the light primitives."
      },
      "invalid": {
        "$type": "color",
        "$value": "{primitives.color.syntax.dark.invalid}",
        "$description": "Syntax invalid or malformed text; always paired with a non-colour cue. Dark base by default; light theme modes reference the light primitives."
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#d7e0eb",
          "$description": "Neutral fill for filled controls at rest."
        },
        "hover": {
          "$type": "color",
          "$value": "#ced9e5",
          "$description": "Neutral filled-control hover step."
        },
        "active": {
          "$type": "color",
          "$value": "#c4d1e0",
          "$description": "Neutral filled-control pressed step."
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)",
          "$description": "Translucent accent selection fill."
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))",
          "$description": "Accent selection composited with the control surface."
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#c4d1e0",
          "$description": "Opaque neutral selection fill."
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.slate.950}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
