      "canvas": {
        "$type": "color",
        "$value": "{primitives.color.neutral.50}",
        "$description": "Primary app canvas."
      },
      "surface": {
        "$type": "color",
        "$value": "{primitives.color.neutral.100}",
        "$description": "Secondary raised surface."
      },
