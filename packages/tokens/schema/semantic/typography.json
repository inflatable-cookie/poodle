{
  "typography": {
    "body": {
      "family": {
        "$type": "fontFamily",
        "$value": "{primitives.typography.font.family.sans}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.size.md}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.lineHeight.md}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{primitives.typography.font.weight.regular}"
      }
    },
    "label": {
      "family": {
        "$type": "fontFamily",
        "$value": "{primitives.typography.font.family.sans}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.size.sm}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.lineHeight.sm}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{primitives.typography.font.weight.medium}"
      },
      "letterSpacing": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.letterSpacing.subtle}"
      },
      "lineHeightTight": {
        "$type": "number",
        "$value": 1
      }
    },
    "counter": {
      "size": {
        "$type": "dimension",
        "$value": "0.75rem"
      }
    },
    "caption": {
      "family": {
        "$type": "fontFamily",
        "$value": "{primitives.typography.font.family.sans}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.size.xs}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.lineHeight.sm}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{primitives.typography.font.weight.medium}"
      },
      "lineHeightRatio": {
        "$type": "number",
        "$value": 1.35
      }
    },
    "overline": {
      "letterSpacing": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.letterSpacing.wide}"
      }
    },
    "heading": {
      "family": {
        "$type": "fontFamily",
        "$value": "{primitives.typography.font.family.sans}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.size.lg}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.lineHeight.lg}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{primitives.typography.font.weight.semibold}"
      }
    },
    "code": {
      "family": {
        "$type": "fontFamily",
        "$value": "{primitives.typography.font.family.mono}"
      },
      "adjustmentRatio": {
        "$type": "number",
        "$value": 0.8125
      },
      "size": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.size.sm}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{primitives.typography.font.lineHeight.sm}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{primitives.typography.font.weight.regular}"
      }
    },
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "initial"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "initial"
      }
    }
  }
}
