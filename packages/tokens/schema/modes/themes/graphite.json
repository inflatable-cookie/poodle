{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#111111"
      },
      "surface": {
        "$type": "color",
        "$value": "#181818"
      },
      "panel": {
        "$type": "color",
        "$value": "#202020"
      },
      "elevated": {
        "$type": "color",
