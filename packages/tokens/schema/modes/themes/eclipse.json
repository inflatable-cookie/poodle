{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#0e1012"
      },
      "surface": {
        "$type": "color",
        "$value": "#15181b"
      },
      "panel": {
        "$type": "color",
        "$value": "#1b1f23"
      },
      "elevated": {
        "$type": "color",
        "$value": "#20252a"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(8, 10, 13, 0.78)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#eef2f6"
      },
      "secondary": {
        "$type": "color",
        "$value": "#99a4b0"
      },
      "inverse": {
        "$type": "color",
        "$value": "#161a1f"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(227, 232, 238, 0.12)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(227, 232, 238, 0.22)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(227, 232, 238, 0.42)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "{primitives.color.amber.500}"
      },
      "hover": {
        "$type": "color",
        "$value": "{primitives.color.amber.400}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{primitives.color.amber.400}"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#eef2f6"
      },
      "muted": {
        "$type": "color",
        "$value": "#99a4b0"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#2d3238"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#22262b"
        },
        "hover": {
          "$type": "color",
          "$value": "#292e34"
        },
        "active": {
          "$type": "color",
          "$value": "#30363d"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#30363d"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
