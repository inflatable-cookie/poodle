        "$type": "color",
        "$value": "#eef2f6"
      },
      "muted": {
        "$type": "color",
        "$value": "#99a4b0"
      }
    },
    "fill": {
      "rest": {
        "$type": "color",
        "$value": "rgba(238, 242, 246, 0.055)"
      },
      "hover": {
        "$type": "color",
        "$value": "rgba(238, 242, 246, 0.085)"
      },
      "active": {
        "$type": "color",
        "$value": "rgba(238, 242, 246, 0.12)"
      }
    },
    "select": {
      "accent": {
        "$type": "color",
        "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
      },
      "accentSubtle": {
        "$type": "color",
