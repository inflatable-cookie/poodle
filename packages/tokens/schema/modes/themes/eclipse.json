      "default": {
        "$type": "color",
        "$value": "rgba(227, 232, 238, 0.22)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(227, 232, 238, 0.42)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "{primitives.color.amber.500}"
