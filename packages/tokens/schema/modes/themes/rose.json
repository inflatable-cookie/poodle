{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#141010"
      },
      "surface": {
        "$type": "color",
        "$value": "#1b1617"
      },
      "panel": {
        "$type": "color",
        "$value": "#221d1e"
      },
      "elevated": {
        "$type": "color",
        "$value": "#292325"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(12,9,9,0.80)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#f0eaeb"
      },
      "secondary": {
        "$type": "color",
        "$value": "#a89fa1"
      },
      "inverse": {
        "$type": "color",
        "$value": "#141010"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(235,226,228,0.11)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(235,226,228,0.21)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(235,226,228,0.40)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#f65c8a"
      },
      "hover": {
        "$type": "color",
        "$value": "#ff7ba3"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#ff7ba3"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#f0eaeb"
      },
      "muted": {
        "$type": "color",
        "$value": "#a89fa1"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#362b2d"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#292123"
        },
        "hover": {
          "$type": "color",
          "$value": "#32282a"
        },
        "active": {
          "$type": "color",
          "$value": "#3a2f32"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#3a2f32"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
