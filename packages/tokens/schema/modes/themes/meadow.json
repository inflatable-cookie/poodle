{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#eef2ec"
      },
      "surface": {
        "$type": "color",
        "$value": "#e6ebe3"
      },
      "panel": {
        "$type": "color",
        "$value": "#f4f7f1"
      },
      "elevated": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(40,50,42,0.30)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#1b241e"
      },
      "secondary": {
        "$type": "color",
        "$value": "#5b655d"
      },
      "inverse": {
        "$type": "color",
        "$value": "#f4f7f1"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "#dce3d6"
      },
      "default": {
        "$type": "color",
        "$value": "#c1ccb9"
      },
      "strong": {
        "$type": "color",
        "$value": "#9caf93"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#188f52"
      },
      "hover": {
        "$type": "color",
        "$value": "#22a862"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#188f52"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#1b241e"
      },
      "muted": {
        "$type": "color",
        "$value": "#5b655d"
      }
    },
    "syntax": {
      "comment": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.comment}"
      },
      "keyword": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.keyword}"
      },
      "string": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.string}"
      },
      "literal": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.literal}"
      },
      "type": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.type}"
      },
      "callable": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.callable}"
      },
      "property": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.property}"
      },
      "operator": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.operator}"
      },
      "punctuation": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.punctuation}"
      },
      "invalid": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.invalid}"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#dbe4da"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#e4ece3"
        },
        "hover": {
          "$type": "color",
          "$value": "#dfe8de"
        },
        "active": {
          "$type": "color",
          "$value": "#d9e3d8"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#d9e3d8"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "#111913"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
