{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#000000"
      },
      "surface": {
        "$type": "color",
        "$value": "#0a0a0a"
      },
      "panel": {
        "$type": "color",
        "$value": "#141414"
      },
      "elevated": {
        "$type": "color",
        "$value": "#1f1f1f"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.90)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "secondary": {
        "$type": "color",
        "$value": "#d4d4d4"
      },
      "inverse": {
        "$type": "color",
        "$value": "#000000"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.24)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.50)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.80)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#ffd400"
      },
      "hover": {
        "$type": "color",
        "$value": "#ffe14d"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#ffe14d"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "muted": {
        "$type": "color",
        "$value": "#d4d4d4"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#262626"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#191919"
        },
        "hover": {
          "$type": "color",
          "$value": "#222222"
        },
        "active": {
          "$type": "color",
          "$value": "#2c2c2c"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#2c2c2c"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "#ffffff"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
