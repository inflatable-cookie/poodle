{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{primitives.color.neutral.50}"
      },
      "surface": {
        "$type": "color",
        "$value": "{primitives.color.neutral.100}"
      },
      "panel": {
        "$type": "color",
        "$value": "{primitives.color.neutral.25}"
      },
      "elevated": {
        "$type": "color",
        "$value": "{primitives.color.neutral.0}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitives.color.neutral.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitives.color.neutral.700}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{primitives.color.neutral.200}"
      },
      "default": {
        "$type": "color",
        "$value": "{primitives.color.neutral.400}"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{primitives.color.neutral.900}"
      },
      "muted": {
        "$type": "color",
        "$value": "{primitives.color.neutral.700}"
      }
    },
    "syntax": {
      "comment": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.comment}"
      },
      "keyword": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.keyword}"
      },
      "string": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.string}"
      },
      "literal": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.literal}"
      },
      "type": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.type}"
      },
      "callable": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.callable}"
      },
      "property": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.property}"
      },
      "operator": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.operator}"
      },
      "punctuation": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.punctuation}"
      },
      "invalid": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.invalid}"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#1668d6"
      },
      "hover": {
        "$type": "color",
        "$value": "#2d86f3"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#1668d6"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#d4deea"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#d7e0eb"
        },
        "hover": {
          "$type": "color",
          "$value": "#ced9e5"
        },
        "active": {
          "$type": "color",
          "$value": "#c4d1e0"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#c4d1e0"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.slate.950}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
