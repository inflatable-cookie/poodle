{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#f4eee3"
      },
      "surface": {
        "$type": "color",
        "$value": "#ece4d5"
      },
      "panel": {
        "$type": "color",
        "$value": "#f9f4ea"
      },
      "elevated": {
        "$type": "color",
        "$value": "#fffdf8"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(60,50,38,0.32)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#2a2622"
      },
      "secondary": {
        "$type": "color",
        "$value": "#6b6157"
      },
      "inverse": {
        "$type": "color",
        "$value": "#faf6ef"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "#e2d8c8"
      },
      "default": {
        "$type": "color",
        "$value": "#c9bca8"
      },
      "strong": {
        "$type": "color",
        "$value": "#a89a85"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#c96442"
      },
      "hover": {
        "$type": "color",
        "$value": "#d97757"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#c96442"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#2a2622"
      },
      "muted": {
        "$type": "color",
        "$value": "#6b6157"
      }
    },
    "syntax": {
      "comment": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.comment}"
      },
      "keyword": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.keyword}"
      },
      "string": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.string}"
      },
      "literal": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.literal}"
      },
      "type": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.type}"
      },
      "callable": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.callable}"
      },
      "property": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.property}"
      },
      "operator": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.operator}"
      },
      "punctuation": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.punctuation}"
      },
      "invalid": {
        "$type": "color",
        "$value": "{primitives.color.syntax.light.invalid}"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#eadfd1"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#f3ebde"
        },
        "hover": {
          "$type": "color",
          "$value": "#eee5d8"
        },
        "active": {
          "$type": "color",
          "$value": "#eadecf"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#eadecf"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "#191613"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
