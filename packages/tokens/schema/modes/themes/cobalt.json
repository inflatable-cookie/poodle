{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#0d0d0d"
      },
      "surface": {
        "$type": "color",
        "$value": "#141414"
      },
      "panel": {
        "$type": "color",
        "$value": "#1c1c1c"
      },
      "elevated": {
        "$type": "color",
        "$value": "#242424"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(6, 6, 6, 0.82)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#ededed"
      },
      "secondary": {
        "$type": "color",
        "$value": "#a3a3a3"
      },
      "inverse": {
        "$type": "color",
        "$value": "#121212"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(198, 198, 198, 0.14)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(198, 198, 198, 0.24)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(198, 198, 198, 0.42)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#5b9dff"
      },
      "hover": {
        "$type": "color",
        "$value": "#7db2ff"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#7db2ff"
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#7fc99a"
      },
      "warning": {
        "$type": "color",
        "$value": "#f0ba55"
      },
      "danger": {
        "$type": "color",
        "$value": "#ef7c72"
      },
      "info": {
        "$type": "color",
        "$value": "#5b9dff"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#ededed"
      },
      "muted": {
        "$type": "color",
        "$value": "#a3a3a3"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#2b2b2b"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#212121"
        },
        "hover": {
          "$type": "color",
          "$value": "#292929"
        },
        "active": {
          "$type": "color",
          "$value": "#303030"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#303030"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
