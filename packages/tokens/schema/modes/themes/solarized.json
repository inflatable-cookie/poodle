{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#002b36"
      },
      "surface": {
        "$type": "color",
        "$value": "#04303a"
      },
      "panel": {
        "$type": "color",
        "$value": "#0a4250"
      },
      "elevated": {
        "$type": "color",
        "$value": "#0f4d5c"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(0,20,26,0.80)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#eee8d5"
      },
      "secondary": {
        "$type": "color",
        "$value": "#93a1a1"
      },
      "inverse": {
        "$type": "color",
        "$value": "#002b36"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(147,161,161,0.24)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(147,161,161,0.38)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(147,161,161,0.58)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#b58900"
      },
      "hover": {
        "$type": "color",
        "$value": "#cb9a10"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#cb9a10"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#eee8d5"
      },
      "muted": {
        "$type": "color",
        "$value": "#93a1a1"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#001e28"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#123741"
        },
        "hover": {
          "$type": "color",
          "$value": "#15333d"
        },
        "active": {
          "$type": "color",
          "$value": "#152f38"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#152f38"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
