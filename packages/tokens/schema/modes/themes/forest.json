{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#0e1210"
      },
      "surface": {
        "$type": "color",
        "$value": "#151a16"
      },
      "panel": {
        "$type": "color",
        "$value": "#1b211d"
      },
      "elevated": {
        "$type": "color",
        "$value": "#212823"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(8,12,10,0.80)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#e9f0ea"
      },
      "secondary": {
        "$type": "color",
        "$value": "#99a49d"
      },
      "inverse": {
        "$type": "color",
        "$value": "#0e1210"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(224,235,228,0.11)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(224,235,228,0.21)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(224,235,228,0.40)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#4dc98a"
      },
      "hover": {
        "$type": "color",
        "$value": "#6fe0a3"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#6fe0a3"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#e9f0ea"
      },
      "muted": {
        "$type": "color",
        "$value": "#99a49d"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#2a352c"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#202922"
        },
        "hover": {
          "$type": "color",
          "$value": "#273229"
        },
        "active": {
          "$type": "color",
          "$value": "#2e3a31"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#2e3a31"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
