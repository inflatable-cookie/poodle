{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#191d24"
      },
      "surface": {
        "$type": "color",
        "$value": "#20252e"
      },
      "panel": {
        "$type": "color",
        "$value": "#272d38"
      },
      "elevated": {
        "$type": "color",
        "$value": "#2f3542"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(12,15,19,0.80)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#e9edf4"
      },
      "secondary": {
        "$type": "color",
        "$value": "#99a2b2"
      },
      "inverse": {
        "$type": "color",
        "$value": "#191d24"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(216,222,233,0.10)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(216,222,233,0.18)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(216,222,233,0.34)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#88c0d0"
      },
      "hover": {
        "$type": "color",
        "$value": "#9fd0de"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#9fd0de"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#e9edf4"
      },
      "muted": {
        "$type": "color",
        "$value": "#99a2b2"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#303744"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#292f3a"
        },
        "hover": {
          "$type": "color",
          "$value": "#2d3440"
        },
        "active": {
          "$type": "color",
          "$value": "#313744"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#313744"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
