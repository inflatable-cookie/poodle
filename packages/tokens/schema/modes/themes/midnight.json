{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "#0c0e13"
      },
      "surface": {
        "$type": "color",
        "$value": "#13161c"
      },
      "panel": {
        "$type": "color",
        "$value": "#191d24"
      },
      "elevated": {
        "$type": "color",
        "$value": "#1f242c"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(7,9,14,0.80)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#e8ebf2"
      },
      "secondary": {
        "$type": "color",
        "$value": "#969ca8"
      },
      "inverse": {
        "$type": "color",
        "$value": "#0c0e13"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(216,222,236,0.11)"
      },
      "default": {
        "$type": "color",
        "$value": "rgba(216,222,236,0.21)"
      },
      "strong": {
        "$type": "color",
        "$value": "rgba(216,222,236,0.40)"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#6d8cff"
      },
      "hover": {
        "$type": "color",
        "$value": "#8aa4ff"
      },
      "focusRing": {
        "$type": "color",
        "$value": "#8aa4ff"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "#e8ebf2"
      },
      "muted": {
        "$type": "color",
        "$value": "#969ca8"
      }
    },
    "surface": {
      "tonal": {
        "$type": "color",
        "$value": "#2a2f3a"
      }
    },
    "control": {
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#1f232d"
        },
        "hover": {
          "$type": "color",
          "$value": "#272b36"
        },
        "active": {
          "$type": "color",
          "$value": "#2f343f"
        }
      }
    },
    "selection": {
      "accent": {
        "fill": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, transparent)"
        },
        "fillSubtle": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, transparent)"
        },
        "fillStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 22%, transparent)"
        },
        "fillSurface": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 14%, var(--poodle-color-background-surface))"
        },
        "fillSurfaceHover": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 18%, var(--poodle-color-background-surface))"
        },
        "fillSolid": {
          "$type": "color",
          "$value": "{color.accent.base}"
        },
        "border": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 32%, var(--poodle-color-border-subtle))"
        },
        "borderStrong": {
          "$type": "color",
          "$value": "color-mix(in srgb, var(--poodle-color-accent-base) 42%, var(--poodle-color-border-default))"
        },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "textSolid": {
          "$type": "color",
          "$value": "{color.text.inverse}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      },
      "neutral": {
        "fill": {
          "$type": "color",
          "$value": "#2f343f"
        },
        "border": {
          "$type": "color",
          "$value": "transparent"
        },
        "text": {
          "$type": "color",
          "$value": "{primitives.color.neutral.0}"
        },
        "indicator": {
          "$type": "color",
          "$value": "{color.accent.base}"
        }
      }
    }
  }
}
