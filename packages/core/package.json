{
  "name": "@inflatable-cookie/poodle-core",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "description": "Poodle framework-free headless behavior core: component state machines, prop getters, and shared interaction machinery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflatable-cookie/poodle.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/inflatable-cookie/poodle#readme",
  "bugs": {
    "url": "https://github.com/inflatable-cookie/poodle/issues"
  },
  "keywords": [
    "design-system",
    "headless",
    "ui",
    "typescript"
  ],
  "bin": {
    "poodle-icons": "./src/icons/build.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/icons/*.ts",
    "./icons/build": {
      "types": "./src/icons/build.d.mts",
      "default": "./src/icons/build.mjs"
    },
    "./tokens": {
      "svelte": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens/runtime": "./src/tokens/runtime.ts",
    "./tokens/css": "./src/tokens/css.ts",
    "./tokens/styles.css": "./src/tokens/generated/css/poodle-tokens.css",
    "./tokens/css/poodle-tokens.css": "./src/tokens/generated/css/poodle-tokens.css",
    "./tokens/themes.css": "./src/tokens/generated/css/poodle-themes.css",
    "./tokens/themes": "./src/tokens/themes.ts",
    "./tokens/metadata": "./src/tokens/metadata.ts",
    "./tokens/units": "./src/tokens/units.ts",
    "./tokens/theme-iceberg.css": "./src/tokens/generated/css/poodle-theme-iceberg.css",
    "./tokens/theme-eclipse.css": "./src/tokens/generated/css/poodle-theme-eclipse.css",
    "./tokens/theme-graphite.css": "./src/tokens/generated/css/poodle-theme-graphite.css",
    "./tokens/theme-midnight.css": "./src/tokens/generated/css/poodle-theme-midnight.css",
    "./tokens/theme-nord.css": "./src/tokens/generated/css/poodle-theme-nord.css",
    "./tokens/theme-rose.css": "./src/tokens/generated/css/poodle-theme-rose.css",
    "./tokens/theme-forest.css": "./src/tokens/generated/css/poodle-theme-forest.css",
    "./tokens/theme-solarized.css": "./src/tokens/generated/css/poodle-theme-solarized.css",
    "./tokens/theme-hornet.css": "./src/tokens/generated/css/poodle-theme-hornet.css",
    "./tokens/theme-cobalt.css": "./src/tokens/generated/css/poodle-theme-cobalt.css",
    "./tokens/theme-clay.css": "./src/tokens/generated/css/poodle-theme-clay.css",
    "./tokens/theme-meadow.css": "./src/tokens/generated/css/poodle-theme-meadow.css",
    "./tokens/density-compact.css": "./src/tokens/generated/css/poodle-density-compact.css",
    "./tokens/density-default.css": "./src/tokens/generated/css/poodle-density-default.css",
    "./tokens/density-comfortable.css": "./src/tokens/generated/css/poodle-density-comfortable.css",
    "./tokens/control-size-xs.css": "./src/tokens/generated/css/poodle-control-size-xs.css",
    "./tokens/control-size-sm.css": "./src/tokens/generated/css/poodle-control-size-sm.css",
    "./tokens/control-size-md.css": "./src/tokens/generated/css/poodle-control-size-md.css",
    "./tokens/control-size-lg.css": "./src/tokens/generated/css/poodle-control-size-lg.css",
    "./tokens/control-size-xl.css": "./src/tokens/generated/css/poodle-control-size-xl.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "bun test",
    "check": "bun x tsc -p ./tsconfig.json"
  },
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "marked": "^18.0.9"
  }
}
