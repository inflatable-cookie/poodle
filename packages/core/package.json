{
  "name": "@inflatable-cookie/poodle-core",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "description": "Poodle framework-free headless behavior core: component state machines, prop getters, and shared interaction machinery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflatable-cookie/poodle.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/inflatable-cookie/poodle#readme",
  "bugs": {
    "url": "https://github.com/inflatable-cookie/poodle/issues"
  },
  "keywords": [
    "design-system",
    "headless",
    "ui",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "poodle-icons": "./dist/icons/build.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./icons/build": {
      "types": "./dist/icons/build.d.mts",
      "import": "./dist/icons/build.mjs",
      "default": "./dist/icons/build.mjs"
    },
    "./icons/*": {
      "types": "./dist/icons/icons/*.d.ts",
      "import": "./dist/icons/icons/*.js",
      "default": "./dist/icons/icons/*.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/runtime": {
      "types": "./dist/tokens/runtime.d.ts",
      "import": "./dist/tokens/runtime.js",
      "default": "./dist/tokens/runtime.js"
    },
    "./tokens/css": {
      "types": "./dist/tokens/css.d.ts",
      "import": "./dist/tokens/css.js",
      "default": "./dist/tokens/css.js"
    },
    "./tokens/themes": {
      "types": "./dist/tokens/themes.d.ts",
      "import": "./dist/tokens/themes.js",
      "default": "./dist/tokens/themes.js"
    },
    "./tokens/metadata": {
      "types": "./dist/tokens/metadata.d.ts",
      "import": "./dist/tokens/metadata.js",
      "default": "./dist/tokens/metadata.js"
    },
    "./tokens/units": {
      "types": "./dist/tokens/units.d.ts",
      "import": "./dist/tokens/units.js",
      "default": "./dist/tokens/units.js"
    },
    "./styles/*": "./dist/styles/*",
    "./tokens/styles.css": "./dist/tokens/generated/css/poodle-tokens.css",
    "./tokens/css/poodle-tokens.css": "./dist/tokens/generated/css/poodle-tokens.css",
    "./tokens/themes.css": "./dist/tokens/generated/css/poodle-themes.css",
    "./tokens/theme-clay.css": "./dist/tokens/generated/css/poodle-theme-clay.css",
    "./tokens/theme-cobalt.css": "./dist/tokens/generated/css/poodle-theme-cobalt.css",
    "./tokens/theme-eclipse.css": "./dist/tokens/generated/css/poodle-theme-eclipse.css",
    "./tokens/theme-forest.css": "./dist/tokens/generated/css/poodle-theme-forest.css",
    "./tokens/theme-graphite.css": "./dist/tokens/generated/css/poodle-theme-graphite.css",
    "./tokens/theme-hornet.css": "./dist/tokens/generated/css/poodle-theme-hornet.css",
    "./tokens/theme-iceberg.css": "./dist/tokens/generated/css/poodle-theme-iceberg.css",
    "./tokens/theme-meadow.css": "./dist/tokens/generated/css/poodle-theme-meadow.css",
    "./tokens/theme-midnight.css": "./dist/tokens/generated/css/poodle-theme-midnight.css",
    "./tokens/theme-nord.css": "./dist/tokens/generated/css/poodle-theme-nord.css",
    "./tokens/theme-rose.css": "./dist/tokens/generated/css/poodle-theme-rose.css",
    "./tokens/theme-solarized.css": "./dist/tokens/generated/css/poodle-theme-solarized.css",
    "./tokens/density-comfortable.css": "./dist/tokens/generated/css/poodle-density-comfortable.css",
    "./tokens/density-compact.css": "./dist/tokens/generated/css/poodle-density-compact.css",
    "./tokens/density-default.css": "./dist/tokens/generated/css/poodle-density-default.css",
    "./tokens/control-size-lg.css": "./dist/tokens/generated/css/poodle-control-size-lg.css",
    "./tokens/control-size-md.css": "./dist/tokens/generated/css/poodle-control-size-md.css",
    "./tokens/control-size-sm.css": "./dist/tokens/generated/css/poodle-control-size-sm.css",
    "./tokens/control-size-xl.css": "./dist/tokens/generated/css/poodle-control-size-xl.css",
    "./tokens/control-size-xs.css": "./dist/tokens/generated/css/poodle-control-size-xs.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/web-distribution/core-build.ts",
    "test": "bun test",
    "check": "bun x tsc -p ./tsconfig.json"
  },
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
