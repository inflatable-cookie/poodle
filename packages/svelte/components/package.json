{
  "name": "@inflatable-cookie/poodle-svelte",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "description": "Poodle Svelte component library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflatable-cookie/poodle.git",
    "directory": "packages/svelte/components"
  },
  "homepage": "https://github.com/inflatable-cookie/poodle#readme",
  "bugs": {
    "url": "https://github.com/inflatable-cookie/poodle/issues"
  },
  "keywords": [
    "components",
    "design-system",
    "svelte",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.client.js",
      "default": "./dist/index.server.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "browser": "./dist/*.client.js",
      "default": "./dist/*.server.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "browser": "./dist/markdown.client.js",
      "default": "./dist/markdown.server.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "browser": "./dist/editor.client.js",
      "default": "./dist/editor.server.js"
    },
    "./editor/codemirror": {
      "types": "./dist/editor-codemirror.d.ts",
      "browser": "./dist/editor-codemirror.js",
      "default": "./dist/editor-codemirror.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "browser": "./dist/rich-text.client.js",
      "default": "./dist/rich-text.server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "browser": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun ../../scripts/web-distribution/svelte-build.ts"
  },
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "peerDependencies": {
    "svelte": ">=5.56.8 <6",
    "marked": "^18.0.9"
  },
  "peerDependenciesMeta": {
    "marked": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@inflatable-cookie/poodle-core": "0.3.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3"
  }
}
