{
  "name": "@inflatable-cookie/poodle-svelte",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "description": "Poodle Svelte component library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflatable-cookie/poodle.git",
    "directory": "packages/svelte/components"
  },
  "homepage": "https://github.com/inflatable-cookie/poodle#readme",
  "bugs": {
    "url": "https://github.com/inflatable-cookie/poodle/issues"
  },
  "keywords": [
    "components",
    "design-system",
    "svelte",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.client.js",
      "default": "./dist/index.server.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "browser": "./dist/*.client.js",
      "default": "./dist/*.server.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "browser": "./dist/markdown.client.js",
      "default": "./dist/markdown.server.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "browser": "./dist/editor.client.js",
      "default": "./dist/editor.server.js"
    },
    "./editor/codemirror": {
      "types": "./dist/editor-codemirror.d.ts",
      "browser": "./dist/editor-codemirror.js",
      "default": "./dist/editor-codemirror.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "browser": "./dist/rich-text.client.js",
      "default": "./dist/rich-text.server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "browser": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun ../../scripts/web-distribution/svelte-build.ts"
  },
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "peerDependencies": {
    "svelte": ">=5.56.8 <6",
    "marked": "^18.0.9"
  },
  "peerDependenciesMeta": {
    "marked": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@inflatable-cookie/poodle-core": ">=0.5.0 <0.6",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.35.1",
    "@tiptap/extension-blockquote": "^3.35.1",
    "@tiptap/extension-bold": "^3.35.1",
    "@tiptap/extension-code": "^3.35.1",
    "@tiptap/extension-code-block": "^3.35.1",
    "@tiptap/extension-document": "^3.35.1",
    "@tiptap/extension-hard-break": "^3.35.1",
    "@tiptap/extension-heading": "^3.35.1",
    "@tiptap/extension-horizontal-rule": "^3.35.1",
    "@tiptap/extension-image": "^3.35.1",
    "@tiptap/extension-italic": "^3.35.1",
    "@tiptap/extension-link": "^3.35.1",
    "@tiptap/extension-list": "^3.35.1",
    "@tiptap/extension-paragraph": "^3.35.1",
    "@tiptap/extension-strike": "^3.35.1",
    "@tiptap/extension-table": "^3.35.1",
    "@tiptap/extension-text": "^3.35.1",
    "@tiptap/extensions": "^3.35.1",
    "@tiptap/pm": "^3.35.1"
  }
}
