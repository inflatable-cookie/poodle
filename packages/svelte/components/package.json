{
  "name": "@poodle/svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Poodle Svelte component library.",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.svelte": {
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    },
    "./types": "./src/types.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "peerDependencies": {
    "@poodle/svelte-tokens": "0.0.0",
    "@poodle/icons-lucide": "0.0.0",
    "svelte": "^5.38.6"
  },
  "peerDependenciesMeta": {
    "@poodle/svelte-tokens": {
      "optional": true
    },
    "@poodle/icons-lucide": {
      "optional": true
    }
  },
  "dependencies": {
    "@poodle/headless": "workspace:*",
    "@poodle/styles": "workspace:*",
    "marked": "^18.0.0"
  }
}
