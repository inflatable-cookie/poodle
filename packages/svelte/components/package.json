{
  "name": "@inflatable-cookie/poodle-svelte",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "description": "Poodle Svelte component library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflatable-cookie/poodle.git",
    "directory": "packages/svelte/components"
  },
  "homepage": "https://github.com/inflatable-cookie/poodle#readme",
  "bugs": {
    "url": "https://github.com/inflatable-cookie/poodle/issues"
  },
  "keywords": [
    "components",
    "design-system",
    "svelte",
    "ui"
  ],
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.svelte": {
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    },
    "./types": "./src/types.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "peerDependencies": {
    "svelte": ">=5.38.6 <6"
  },
  "dependencies": {
    "@inflatable-cookie/poodle-core": "0.1.0",
    "marked": "^18.0.9"
  }
}
