{
  "name": "@inflatable-cookie/poodle-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Poodle Svelte component library.",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.svelte": {
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    },
    "./types": "./src/types.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "poodleRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  },
  "peerDependencies": {
    "svelte": ">=5.38.6 <6"
  },
  "dependencies": {
    "@inflatable-cookie/poodle-core": "0.1.0",
    "marked": "^18.0.0"
  }
}
