    "./control-size-xs.css": "./src/generated/css/poodle-control-size-xs.css",
    "./control-size-sm.css": "./src/generated/css/poodle-control-size-sm.css",
    "./control-size-md.css": "./src/generated/css/poodle-control-size-md.css",
    "./control-size-lg.css": "./src/generated/css/poodle-control-size-lg.css",
    "./control-size-xl.css": "./src/generated/css/poodle-control-size-xl.css",
    "./themes": "./src/themes.ts",
    "./metadata": "./src/metadata.ts",
    "./units": "./src/units.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "poodleRelease": {
    "publicIntent": true,
