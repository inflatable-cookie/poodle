    "./themes.css": "./src/generated/css/poodle-themes.css",
    "./theme-light.css": "./src/generated/css/poodle-theme-light.css",
    "./theme-dark.css": "./src/generated/css/poodle-theme-dark.css",
    "./theme-graphite.css": "./src/generated/css/poodle-theme-graphite.css",
    "./theme-midnight.css": "./src/generated/css/poodle-theme-midnight.css",
    "./theme-nord.css": "./src/generated/css/poodle-theme-nord.css",
    "./theme-rose.css": "./src/generated/css/poodle-theme-rose.css",
    "./theme-forest.css": "./src/generated/css/poodle-theme-forest.css",
    "./theme-solarized.css": "./src/generated/css/poodle-theme-solarized.css",
    "./theme-high-contrast.css": "./src/generated/css/poodle-theme-high-contrast.css",
    "./density-compact.css": "./src/generated/css/poodle-density-compact.css",
    "./density-default.css": "./src/generated/css/poodle-density-default.css",
