{
  "name": "@pug/svelte-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pug Svelte token and theme helpers backed by generated artifacts.",
  "svelte": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./css": "./src/css.ts",
    "./styles.css": "./src/generated/css/pug-tokens.css",
    "./css/pug-tokens.css": "./src/generated/css/pug-tokens.css",
    "./theme-light.css": "./src/generated/css/pug-theme-light.css",
    "./theme-dark.css": "./src/generated/css/pug-theme-dark.css",
    "./theme-loophole-studio.css": "./src/generated/css/pug-theme-loophole-studio.css",
    "./density-compact.css": "./src/generated/css/pug-density-compact.css",
    "./density-comfortable.css": "./src/generated/css/pug-density-comfortable.css",
    "./control-size-sm.css": "./src/generated/css/pug-control-size-sm.css",
    "./control-size-md.css": "./src/generated/css/pug-control-size-md.css",
    "./control-size-lg.css": "./src/generated/css/pug-control-size-lg.css",
    "./themes": "./src/themes.ts",
    "./metadata": "./src/metadata.ts",
    "./units": "./src/units.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pugRelease": {
    "publicIntent": true,
    "channel": "preview",
    "stability": "pre-release"
  }
}
